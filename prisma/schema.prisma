// Fase 0 — schema de dados proposto (secção 6 do master prompt).
// Pronto a migrar; ajustar índices/constraints à medida que MVP1 avança.
// Convenções: ids cuid(), timestamps createdAt/updatedAt em todas as entidades,
// enums em PascalCase, tabelas em PascalCase singular (Prisma model), FKs explícitas.

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: connection pooling do Supabase (porta 6543, pgbouncer) — usada em runtime
// pelas Netlify Functions (curta duração, muitas invocações concorrentes).
// DIRECT_URL: ligação direta do Supabase (porta 5432) — usada só por `prisma db push`
// no build da Netlify (ver netlify.toml e docs/decisions.md).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────

enum CefrLevel {
  PRE_A1
  A1
  A2
  B1
  B2
  C1
  C2
}

enum LearningTrack {
  STANDARD
  INTENSIVE
}

enum Pillar {
  GRAMMAR
  VOCABULARY
  LISTENING
  SPEAKING
  PRONUNCIATION
  READING
  WRITING
  TRANSLATION
}

enum EnglishVariant {
  BRITISH
  AMERICAN
  INTERNATIONAL
}

enum SubscriptionPlan {
  FREE
  PREMIUM
  PRO
  INTENSIVE_PREMIUM
}

enum Goal {
  TRAVEL
  WORK
  INTERVIEW
  PROMOTION
  RELOCATION
  MEETINGS
  EXAM
  GENERAL
}

enum AssessmentType {
  DAILY
  WEEKLY
  MONTHLY
  UNIT
  MODULE
  LEVEL_EXAM
  PLACEMENT
}

enum TutorPersonality {
  COACH
  PROFESSOR
  CONVERSATION_PARTNER
  EXAMINER
  INTERVIEWER
  NATIVE_FRIEND
  ROLEPLAY
}

enum AttemptSource {
  LESSON
  PRACTICE
  ASSESSMENT
  AI_CONVERSATION
}

// ─────────────────────────────────────────────────────────────────────────
// UTILIZADOR E PERFIL
// ─────────────────────────────────────────────────────────────────────────

// Conta partilhada da família (login único no Supabase Auth — email/password).
// Desde a Fase 6 ("Família"), uma conta pode ter vários Profile (estilo
// Netflix): quem faz login aqui não é necessariamente quem está a aprender.
// Ver Profile abaixo e src/lib/session.ts.
model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  passwordHash       String?
  authProvider       String? // "credentials" | "google" | etc.
  interfaceLanguage  String   @default("pt-PT")
  subscriptionPlan   SubscriptionPlan @default(FREE)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  profiles           Profile[]
}

// Perfil individual dentro de uma conta — Fase 6 ("Família": perfis
// múltiplos, progresso individual, privacidade entre perfis). Todo o
// progresso de aprendizagem (as ~15 tabelas abaixo) pertence a um Profile,
// não diretamente à conta — duas pessoas na mesma conta têm currículo,
// XP, streak, erros e histórico completamente separados. Contas com um só
// perfil (o caso comum, incluindo todas as contas criadas antes desta
// funcionalidade) não veem nenhum seletor: o perfil único é escolhido
// automaticamente em requireUser(), sem passo extra. Ver src/lib/session.ts.
model Profile {
  id          String   @id @default(cuid())
  userId      String   // conta dona deste perfil
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  avatarColor String   @default("verdigris") // sem upload de imagem — custo zero, ver docs/decisions.md
  isChild     Boolean  @default(false)
  createdAt   DateTime @default(now())

  learningProfile    LearningProfile?
  placementTests     PlacementTest[]
  attempts           ExerciseAttempt[]
  speakingAttempts   SpeakingAttempt[]
  writingAttempts    WritingAttempt[]
  translations       Translation[]
  errors             UserError[]
  reviewItems        ReviewScheduleItem[]
  assessments        AssessmentResult[]
  certificates       Certificate[]
  achievements       UserAchievement[]
  aiConversations    AIConversation[]
  learningPlan       LearningPlan?
  intensivePlan      IntensivePlan?
  analyticsEvents    AnalyticsEvent[]
  discoveredWords    DiscoveredWord[]

  @@index([userId])
}

model LearningProfile {
  id                  String    @id @default(cuid())
  // Nota Fase 6: `userId` aqui (e nas ~14 tabelas de progresso abaixo) aponta
  // para Profile.id, não User.id, desde a introdução de perfis familiares —
  // o nome do campo ficou por mudar de propósito (evitar alterar dezenas de
  // ficheiros que já fazem `where: { userId: ... }`), só o alvo da FK mudou.
  // Ver src/lib/session.ts, docs/decisions.md.
  userId              String    @unique
  profile             Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentLevel        CefrLevel @default(PRE_A1)
  currentSublevel     Int       @default(1) // 1-3, ignorado em PRE_A1

  track               LearningTrack @default(STANDARD)
  dailyMinutesTarget  Int       @default(15)

  goal                Goal      @default(GENERAL)
  targetDate          DateTime?
  profession          String?
  interests           String[]  @default([])
  englishVariant      EnglishVariant @default(INTERNATIONAL)
  immersionMode       Boolean   @default(false) // esconde traduções PT nas lições — item #12 da lista de melhorias
  accessibleReadingMode Boolean @default(false) // tipografia mais legível (espaçamento, sem itálico) — item #18

  // skill scores 0-100 por pilar, recalculados após assessments
  grammarScore        Int       @default(0)
  vocabularyScore     Int       @default(0)
  listeningScore      Int       @default(0)
  speakingScore       Int       @default(0)
  pronunciationScore  Int       @default(0)
  readingScore        Int       @default(0)
  writingScore        Int       @default(0)
  translationScore    Int       @default(0)

  weakAreas           Pillar[]  @default([])
  strongAreas         Pillar[]  @default([])

  // Gamificação adulta — secção 9 do master prompt (XP, streak; nunca punitivo).
  xp                  Int       @default(0)
  currentStreak       Int       @default(0)
  longestStreak       Int       @default(0)
  lastActivityAt      DateTime?
  // Fase 12 (auditoria 2026-08-27, "reparação de streak") — cada semana de
  // streak (7 dias seguidos) ganha 1 "congelamento", até um máximo de 2
  // guardados: perder exatamente 1 dia não zera o streak se houver pelo
  // menos 1 disponível, gasta-o e o streak continua. Falhar 2+ dias seguidos
  // continua a resetar sempre — não é para apagar a consequência de parar,
  // só para não punir um dia esquecido isolado. Ver recordActivity().
  streakFreezes       Int       @default(0)

  updatedAt           DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// ESTRUTURA CURRICULAR
// ─────────────────────────────────────────────────────────────────────────

model Level {
  id          String     @id @default(cuid())
  cefr        CefrLevel  @unique
  order       Int        @unique
  title       String
  description String

  sublevels   Sublevel[]
}

model Sublevel {
  id          String   @id @default(cuid())
  levelId     String
  level       Level    @relation(fields: [levelId], references: [id])
  number      Int      // 1-3
  code        String   @unique // ex. "A1.2"
  order       Int      @unique

  modules     Module[]

  @@unique([levelId, number])
}

model Module {
  id          String    @id @default(cuid())
  sublevelId  String
  sublevel    Sublevel  @relation(fields: [sublevelId], references: [id])
  title       String
  theme       String
  order       Int

  units       Unit[]
}

model Unit {
  id          String   @id @default(cuid())
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id])
  title       String
  order       Int
  skippable   Boolean  @default(true) // elegível para level skipping via fast-check

  lessons          Lesson[]
  grammarConcepts  GrammarConcept[]
}

model Lesson {
  id          String   @id @default(cuid())
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id])
  title       String
  pillars     Pillar[] // pilares cobertos por esta lição
  order       Int
  contentJson Json     // segue prisma/../08-schema-json-conteudo.md

  exercises   Exercise[]

  @@index([unitId])
}

// ─────────────────────────────────────────────────────────────────────────
// GRAMÁTICA E VOCABULÁRIO
// ─────────────────────────────────────────────────────────────────────────

// Anatomia obrigatória: regra → explicação → exemplo → tradução →
// erro comum PT→EN → correção → exercício → speaking → writing → translation → uso real
model GrammarConcept {
  id                String   @id @default(cuid())
  unitId            String
  unit              Unit     @relation(fields: [unitId], references: [id])

  title             String
  rule              String
  simpleExplanation String
  example           String
  exampleTranslation String
  commonMistakePt   String
  correction        String
  realWorldExample  String

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  exercises         Exercise[]

  @@index([unitId])
}

model VocabularyItem {
  id            String   @id @default(cuid())
  headword      String
  translationPt String
  definitionEn  String
  cefr          CefrLevel
  audioUrl      String?
  ipa           String?
  collocations  String[] @default([])
  synonyms      String[] @default([])
  antonyms      String[] @default([])
  exampleSentences String[] @default([])
  difficulty    Int      @default(1) // 1-5

  createdAt     DateTime @default(now())

  discoveredBy  DiscoveredWord[]

  @@index([cefr])
}

// ─────────────────────────────────────────────────────────────────────────
// SMART WORD ASSIST — "toca numa palavra, percebe sem sair do texto"
// ─────────────────────────────────────────────────────────────────────────

// "Palavras que descobri" do utilizador — progresso pessoal, distinto de
// VocabularyItem (dicionário partilhado, sem dono). Uma linha por palavra
// única consultada por utilizador; toques repetidos incrementam queryCount
// em vez de duplicar. Ver src/lib/wordAssist/lookupWord.ts.
model DiscoveredWord {
  id                  String    @id @default(cuid())
  userId              String    // aponta para Profile.id, mesmo padrão de LearningProfile/UserError
  profile             Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabularyItemId    String?   // preenchido quando resolvido a partir do dicionário partilhado
  vocabularyItem      VocabularyItem? @relation(fields: [vocabularyItemId], references: [id])
  headword            String    // sempre preenchido, mesmo sem match em VocabularyItem
  contextualMeaning   String    // significado tal como resolvido no contexto da descoberta
  contextSentence     String
  cefr                CefrLevel?
  queryCount          Int       @default(1)
  correctGuessCount   Int       @default(0)
  incorrectGuessCount Int       @default(0)
  masteryLevel        Int       @default(0) // 0-3, sobe com revisões corretas no SRS (ReviewScheduleItem)
  discoveredAt        DateTime  @default(now())
  lastQueriedAt        DateTime @default(now())

  @@unique([userId, headword])
  @@index([userId, lastQueriedAt])
}

// Cache partilhada (entre TODOS os utilizadores) das desambiguações feitas
// pela IA para um par (palavra, frase) — existe para nunca pagar duas vezes a
// mesma chamada ao Gemini. A quota diária é global (ver checkAiRateLimit,
// src/lib/ai/rateLimit.ts): sem este cache, a mesma palavra ambígua consultada
// por utilizadores diferentes no mesmo texto (ex. todos leem o mesmo passage
// de Prática de Leitura) chamaria a IA uma vez por utilizador, em vez de uma
// vez no total.
model WordContextCache {
  id            String   @id @default(cuid())
  headword      String
  contextHash   String   // hash da frase normalizada (lowercase, trim, sem pontuação)
  meaningEn     String
  translationPt String
  createdAt     DateTime @default(now())

  @@unique([headword, contextHash])
}

// ─────────────────────────────────────────────────────────────────────────
// EXERCÍCIOS
// ─────────────────────────────────────────────────────────────────────────

model Exercise {
  id               String   @id @default(cuid())
  lessonId         String?
  lesson           Lesson?  @relation(fields: [lessonId], references: [id])
  grammarConceptId String?
  grammarConcept   GrammarConcept? @relation(fields: [grammarConceptId], references: [id])

  pillar           Pillar
  cefr             CefrLevel
  contentJson      Json     // ver 08-schema-json-conteudo.md
  generatedByAi    Boolean  @default(false)
  qaApproved       Boolean  @default(false)

  createdAt        DateTime @default(now())

  attempts         ExerciseAttempt[]

  @@index([pillar, cefr])
}

// Question foi removido daqui em 2026-08-26 (auditoria, limpeza de schema
// morto): nunca era criado em lado nenhum do código — no MVP1 o próprio
// Exercise já É a pergunta. Answer.questionId (abaixo) já tinha sido tornado
// opcional antes desta limpeza, precisamente por causa disto; agora o campo
// deixa de existir de todo, já que nada nunca o escreve. Ver docs/decisions.md.
model Answer {
  id          String   @id @default(cuid())
  attemptId   String
  attempt     ExerciseAttempt @relation(fields: [attemptId], references: [id])
  givenAnswer String
  isCorrect   Boolean
  createdAt   DateTime @default(now())
}

model ExerciseAttempt {
  id          String   @id @default(cuid())
  userId      String   // aponta para Profile.id, ver nota em LearningProfile
  profile     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id])
  source      AttemptSource @default(LESSON)
  score       Int?
  durationMs  Int?
  createdAt   DateTime @default(now())

  answers     Answer[]

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// SPEAKING / WRITING / TRANSLATION
// ─────────────────────────────────────────────────────────────────────────

model SpeakingAttempt {
  id             String   @id @default(cuid())
  userId         String   // aponta para Profile.id, ver nota em LearningProfile
  profile        Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt         String
  audioUrl       String
  transcript     String?
  source         AttemptSource @default(PRACTICE)

  feedbackJson   Json?    // grammar/vocab/naturalness/fluency, "correct" vs "natural"
  fluencyScore   Int?
  pronunciationScore Int? // sinal indireto via IA a partir do transcript de voz (sem áudio real, sem scoring fonético avançado) — ver src/app/(app)/learn/actions.ts, correção 2026-08-26 (auditoria: antes ficava sempre null)
  responseTimeMs Int?     // para Automaticity Training / Quick Speak
  confidenceSelfRating Int? // 1-5, autoavaliado pelo utilizador após ver o feedback — "métrica de confiança" da auditoria (secção 294). Subjetivo por natureza (não é medido, é perguntado), mas é o sinal disponível sem análise de voz avançada. Ver src/app/(app)/learn/actions.ts.

  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

model WritingAttempt {
  id           String   @id @default(cuid())
  userId       String   // aponta para Profile.id, ver nota em LearningProfile
  profile      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt       String
  text         String
  source       AttemptSource @default(PRACTICE)

  feedbackJson Json? // grammar/vocab/spelling/punctuation/coherence/cohesion/register/naturalness
  score        Int?

  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model Translation {
  id          String   @id @default(cuid())
  userId      String   // aponta para Profile.id, ver nota em LearningProfile
  profile     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceText  String
  sourceLang  String   // "pt" | "en"
  userAnswer  String
  correctAnswer String
  isCorrect   Boolean?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// ERROS E REPETIÇÃO ESPAÇADA
// ─────────────────────────────────────────────────────────────────────────

model UserError {
  id               String   @id @default(cuid())
  userId           String   // aponta para Profile.id, ver nota em LearningProfile
  profile          Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  pillar           Pillar
  errorType        String   // ex. "present-perfect-vs-past-simple", "false-friend:actually"
  commonMistakePt  String?
  sourceText       String
  correction       String
  occurrences      Int      @default(1)
  lastOccurredAt   DateTime @default(now())
  resolvedAt       DateTime?

  reviewItems      ReviewScheduleItem[]

  @@index([userId, pillar])
}

model ReviewScheduleItem {
  id             String   @id @default(cuid())
  userId         String   // aponta para Profile.id, ver nota em LearningProfile
  profile        Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userErrorId    String?
  userError      UserError? @relation(fields: [userErrorId], references: [id])
  itemType       String   // "grammar_concept" | "vocabulary_item" | "error"
  itemRefId      String   // id do GrammarConcept/VocabularyItem/UserError referenciado

  intervalDays   Int      @default(1)
  easeFactor     Float    @default(2.5) // algoritmo tipo SM-2
  repetitions    Int      @default(0)
  dueAt          DateTime
  lastReviewedAt DateTime?

  @@unique([userId, itemType, itemRefId])
  @@index([userId, dueAt])
}

// ─────────────────────────────────────────────────────────────────────────
// AVALIAÇÃO E CERTIFICAÇÃO
// ─────────────────────────────────────────────────────────────────────────

model PlacementTest {
  id            String    @id @default(cuid())
  userId        String    // aponta para Profile.id, ver nota em LearningProfile
  profile       Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  track         LearningTrack

  resultLevel   CefrLevel?
  resultSublevel Int?
  skillProfileJson Json?  // scores por pilar
  weakAreas     Pillar[]  @default([])

  startedAt     DateTime  @default(now())
  completedAt   DateTime?
}

model AssessmentResult {
  id           String   @id @default(cuid())
  userId       String   // aponta para Profile.id, ver nota em LearningProfile
  profile      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         AssessmentType
  levelId      String?
  scoreJson    Json     // score por pilar + score global
  passed       Boolean?
  createdAt    DateTime @default(now())

  @@index([userId, type, createdAt])
}

model Certificate {
  id            String   @id @default(cuid())
  userId        String   // aponta para Profile.id, ver nota em LearningProfile
  profile       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  cefr          CefrLevel
  overallScore  Int
  classification String  // Not ready | Developing | Competent | Strong | Exceptional
  skillBreakdownJson Json
  issuedAt      DateTime @default(now())
  verificationCode String @unique @default(cuid())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────
// GAMIFICAÇÃO
// ─────────────────────────────────────────────────────────────────────────

model Achievement {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  description String
  iconUrl     String?

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String   // aponta para Profile.id, ver nota em LearningProfile
  profile       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  earnedAt      DateTime @default(now())

  @@unique([userId, achievementId])
}

// ─────────────────────────────────────────────────────────────────────────
// IA CONVERSACIONAL
// ─────────────────────────────────────────────────────────────────────────

model AIConversation {
  id            String   @id @default(cuid())
  userId        String   // aponta para Profile.id, ver nota em LearningProfile
  profile       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  personality   TutorPersonality
  scenario      String?  // null quando é sessão livre de tutoria
  messagesJson  Json     // histórico de turnos
  feedbackJson  Json?    // feedback estruturado de fim de sessão
  startedAt     DateTime @default(now())
  endedAt       DateTime?

  @@index([userId, startedAt])
}

// ─────────────────────────────────────────────────────────────────────────
// PLANOS DE APRENDIZAGEM
// ─────────────────────────────────────────────────────────────────────────

model LearningPlan {
  id            String   @id @default(cuid())
  userId        String   @unique // aponta para Profile.id, ver nota em LearningProfile
  profile       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyMinutes  Int
  focusPillars  Pillar[] @default([])
  planJson      Json     // sequência de próximas lições/unidades
  updatedAt     DateTime @updatedAt
}

model IntensivePlan {
  id             String   @id @default(cuid())
  userId         String   @unique // aponta para Profile.id, ver nota em LearningProfile
  profile        Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal           Goal
  startDate      DateTime
  targetDate     DateTime
  totalDays      Int
  currentDay     Int      @default(1)
  weeklyThemesJson Json   // foco temático por semana
  recoveryLog    Json?    // histórico de recálculos (faltas/excesso)
  updatedAt      DateTime @updatedAt
}

// Bootcamp e BootcampEnrollment removidos daqui em 2026-08-26 (auditoria,
// limpeza de schema morto): nenhuma rota, página ou script de seed alguma vez
// os referenciou — puro vapor desde a Fase 0, incluindo o valor BOOTCAMP do
// enum AttemptSource (também removido). Se a ideia de bootcamps intensivos
// for retomada no futuro, fica registada aqui para não se perder: um
// "bootcamp" seria um currículo curto e intensivo (ex. "7-day-speaking-boost")
// com progresso próprio por utilizador. Ver docs/decisions.md.

// ─────────────────────────────────────────────────────────────────────────
// ANALYTICS
// ─────────────────────────────────────────────────────────────────────────

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?  // aponta para Profile.id, ver nota em LearningProfile
  profile    Profile? @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventName  String
  propsJson  Json?
  createdAt  DateTime @default(now())

  @@index([eventName, createdAt])
  @@index([userId, createdAt])
}
