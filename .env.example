# Base de dados (Supabase Postgres — ver docs/decisions.md e docs/11-deploy-netlify-supabase.md)
# DATABASE_URL: connection string com "Connection pooling" ativado no painel do Supabase
# (Project Settings → Database → Connection string → "Transaction" mode, porta 6543).
DATABASE_URL="postgresql://postgres:password@aws-0-xxxx.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: a mesma connection string mas em modo direto (porta 5432, sem pgbouncer)
# — só usada por `prisma db push` durante o build da Netlify.
DIRECT_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# URL pública do site em produção — usada para construir o link de confirmação de
# email (Supabase Auth → /auth/callback). Na Netlify: o domínio dado por ela
# (ex. https://ingles-platform.netlify.app), definido como variável de ambiente do site.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# IA — Anthropic (AI Tutor, correção, Content QA)
ANTHROPIC_API_KEY=""

# Speech-to-text — Whisper API (ver docs/decisions.md: decisão discutida)
OPENAI_API_KEY=""

# Text-to-speech — Azure Neural TTS por omissão (ver docs/decisions.md)
AZURE_TTS_KEY=""
AZURE_TTS_REGION=""
